# ─────────────────────────────────────────────────────────────
# PBX Platform — root environment (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pbx
POSTGRES_USER=pbx
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://pbx:change_me@postgres:5432/pbx

# ── Cache / realtime (Redis) ──
REDIS_URL=redis://redis:6379

# ── Event bus (NATS) ──
NATS_URL=nats://nats:4222

# ── API (NestJS) ──
API_PORT=4000
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Telephony service ──
ARI_URL=http://asterisk:8088/ari
ARI_USER=asterisk
ARI_PASSWORD=asteriskpwd
ARI_APP=pbx
TELEPHONY_PORT=5000

# ── Asterisk / Kamailio / media ──
PUBLIC_HOST=pbx.example.com
SIP_DOMAIN=pbx.example.com
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
PJSIP_WSS_PORT=8089
COTURN_HOST=pbx.example.com
COTURN_PORT=3478
TURNS_PORT=5349
